-- Create the test table
CREATE OR REPLACE TRANSIENT TABLE consecutive_test (
    id INT,
    numbers INT
);

-- Insert sample rows to test consecutive occurrences
INSERT INTO consecutive_test (id, numbers) 
VALUES
    (1, 1), -- Lone number
    (2, 2), -- Start of 3 consecutive 2s
    (3, 2), 
    (4, 2), -- End of 3 consecutive 2s (Should match)
    (5, 1), -- Breaks the streak
    (6, 3), -- Start of 4 consecutive 3s
    (7, 3), 
    (8, 3), -- Reaches 3 consecutive (Should match)
    (9, 3), -- Reaches 4 consecutive (Should match)
    (10, 2), -- A '2' appears again, but it's not consecutive with the earlier 2s
    (11, 4), -- Start of 2 consecutive 4s
    (12, 4); -- Only 2 consecutive (Should NOT match)

    SELECT DISTINCT numbers 
FROM ( 
    SELECT 
        numbers,  
        LEAD(numbers, 1) OVER (ORDER BY id) AS next_num, 
        LEAD(numbers, 2) OVER (ORDER BY id) AS next_next_num 
    FROM consecutive_test 
) t 
WHERE numbers = next_num AND numbers = next_next_num;
