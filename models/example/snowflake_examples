-- Create the test table
CREATE OR REPLACE TRANSIENT TABLE temperature_test (
    Days DATE,
    Temp INT
);

-- Insert sample rows to test temperature increases
INSERT INTO temperature_test (Days, Temp) 
VALUES
    ('2026-07-01', 72), -- Day 1: No previous day (Should NOT match)
    ('2026-07-02', 75), -- Higher than July 1st (75 > 72) -> Should match
    ('2026-07-03', 70), -- Lower than July 2nd (70 < 75) -> Should NOT match
    ('2026-07-04', 70), -- Same as July 3rd (70 = 70)   -> Should NOT match
    ('2026-07-05', 82), -- Higher than July 4th (82 > 70) -> Should match
    ('2026-07-06', 80); -- Lower than July 5th (80 < 82) -> Should NOT match

    WITH TempWithLag AS ( 
    SELECT 
        Days, 
        Temp, 
        LAG(Temp) OVER (ORDER BY Days) AS prev_temp 
    FROM temperature_test 
) 
SELECT Days 
FROM TempWithLag 
WHERE Temp > prev_temp
ORDER BY Days;

