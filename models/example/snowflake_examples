CREATE OR REPLACE TABLE raw_events_table (
    inserted_at TIMESTAMP_NTZ DEFAULT CURRENT_TIMESTAMP(),
    source_data VARIANT
);

INSERT INTO raw_events_table (source_data)
SELECT PARSE_JSON('{
  "customer_id": "CUST-9921",
  "interaction_type": "web_click",
  "metadata": {
    "device": "mobile",
    "os": "iOS"
  },
  "cart_items": [
    {"item_id": "PROD-101", "price": 49.99, "quantity": 1},
    {"item_id": "PROD-204", "price": 15.50, "quantity": 2}
  ]
}');
select * from raw_events_table;
SELECT
    -- Top-level attributes
    source_data:customer_id::STRING AS customer_id,
    source_data:interaction_type::STRING AS interaction_type,    
    -- Nested metadata object attributes
    source_data:metadata.device::STRING AS device,
    source_data:metadata.os::STRING AS os,
    -- Flattened array attributes
    cart.value:item_id::STRING AS item_id,
    cart.value:price::FLOAT AS item_price,
    cart.value:quantity::INT AS item_quantity
FROM raw_events_table,
LATERAL FLATTEN(input => source_data:cart_items) cart;

