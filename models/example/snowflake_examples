CREATE OR REPLACE PROCEDURE truncate_all_tables_in_schema(schema_name STRING)
RETURNS STRING
LANGUAGE SQL
EXECUTE AS CALLER
AS
$$
DECLARE
    table_name STRING;
    truncated_count INT DEFAULT 0;
    -- Cursor to fetch all base tables in the current database and specified schema
    table_cursor CURSOR FOR 
        SELECT table_name 
        FROM information_schema.tables 
        WHERE table_schema = :schema_name 
          AND table_type = 'BASE TABLE';
BEGIN
    -- Ensure the input schema name is handled case-insensitively if passed in lower case,
    -- but Snowflake system views expect uppercase unless quoted.
    schema_name := UPPER(:schema_name);

    OPEN table_cursor;
    
    LOOP
        FETCH table_cursor INTO table_name;
        -- Exit the loop when there are no more rows
        IF (table_name IS NULL) THEN
            BREAK;
        END IF;
        
        -- Dynamically construct and execute the TRUNCATE statement
        -- Using IDENTIFIER handles special characters or case sensitivity safely
        EXECUTE IMMEDIATE 'TRUNCATE TABLE ' || :schema_name || '.' || IDENTIFIER(:table_name);
        
        truncated_count := truncated_count + 1;
    END LOOP;
    
    CLOSE table_cursor;
    
    RETURN 'Successfully truncated ' || :truncated_count || ' tables in schema ' || :schema_name || '.';
EXCEPTION
    WHEN OTHER THEN
        -- Safely close the cursor if an error occurs mid-execution
        CLOSE table_cursor;
        RAISE;
END;
$$;

CALL truncate_all_tables_in_schema('TRUNC_SCHEMA');

