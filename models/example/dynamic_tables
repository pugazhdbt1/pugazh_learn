SELECT * FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = 'TABLE_B';

SELECT 
    ID,
    NAME,
    SALARY
FROM TABLE_A A
FULL OUTER JOIN TABLE_B B
    ON A.ID = B.ID and A.NAME = B.NAME AND A.SALARY = B.SALARY;

SELECT 
    COALESCE(A.ID, B.ID) AS ID,
    COALESCE(A.NAME, B.NAME) AS NAME,
    COALESCE(A.SALARY, B.SALARY) AS SALARY
FROM TABLE_A A
FULL OUTER JOIN TABLE_B B
    ON A.ID = B.ID and A.NAME = B.NAME AND A.SALARY = B.SALARY;

WITH CTE1 AS
(
SELECT ID,NAME,SALARY FROM TABLE_A
UNION ALL
SELECT ID,NAME,SALARY FROM TABLE_B
),

CTE2 AS
(SELECT ID,NAME,SALARY FROM CTE1
QUALIFY ROW_NUMBER() OVER (PARTITION BY ID ORDER BY SALARY DESC) = 2
)
SELECT * FROM CTE2;
