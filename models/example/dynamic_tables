--Layer 1 (Raw)
CREATE OR REPLACE TABLE raw_orders (
    order_id INT,
    customer_id INT,
    order_date TIMESTAMP,
    amount NUMBER(10, 2),
    city VARCHAR,
    status VARCHAR
);

--Layer 1 (Stage)
CREATE OR REPLACE DYNAMIC TABLE dt_silver_orders
  TARGET_LAG = '1 minutes'
  WAREHOUSE = compute_wh
AS
SELECT 
    order_id,
    customer_id,
    TO_DATE(order_date) AS order_date,
    amount,
    UPPER(city) AS city
FROM raw_orders
WHERE status = 'COMPLETED';

--Layer 3 (DEV)
CREATE OR REPLACE DYNAMIC TABLE dt_gold_regional_revenue
  TARGET_LAG = '3 minutes'
  WAREHOUSE = compute_wh
AS
SELECT 
    city,
    COUNT(order_id) AS total_orders,
    SUM(amount) AS total_revenue,
    MAX(order_date) AS last_updated_date
FROM dt_silver_orders
GROUP BY city;

