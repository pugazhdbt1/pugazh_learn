-- Step 2: Create a standard view
CREATE OR REPLACE materialized VIEW mv_active_employees AS
SELECT 
    emp_id,
    CONCAT(first_name, ' ', last_name) AS full_name,
    department
FROM employee_raw
WHERE status = 'ACTIVE';

select * from mv_active_employees;

-- Creating a Secure View to mask sensitive data
CREATE OR REPLACE SECURE VIEW sv_active_employees AS
SELECT 
    emp_id,
    CONCAT(first_name, ' ', last_name) AS full_name,
    department
FROM employee_raw
WHERE status = 'ACTIVE';

select * from sv_active_employees;

